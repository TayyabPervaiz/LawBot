# Get your free Groq API key at: https://console.groq.com/keys
# 1. Sign up for free at https://console.groq.com
# 2. Go to API Keys section
# 3. Create a new API key
# 4. Copy it and paste below
GROQ_API_KEY=your_groq_api_key_here

# LLM provider (plan Section 5.7). Only "groq" is wired today.
LLM_PROVIDER=groq

# Optional: Override the default LLM model
LLM_MODEL=llama-3.3-70b-versatile

# Optional: Override the multilingual embedding model (default in src/config.py).
# Changing this requires a full re-index.
# EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2

# Optional: local cross-encoder reranker. Leave empty to disable (RRF-only).
# RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
